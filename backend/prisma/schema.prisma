generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Administrador {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  cargo     String   // "ADMIN_GERAL", "COORDENADOR", "SECRETARIO", "TECNICO"
  municipio String
  senhaHash String   // para armazenar hash da senha
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id                     Int       @id @default(autoincrement())
  nome                   String
  telefone               String    @unique
  dataNascimento         String?   // ISO date
  dataUltimaMenstruacao  String?   // ISO date
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  mensagens  Mensagem[]
  exames     Exame[]
  consultas  Consulta[]
}

model Mensagem {
  id         Int      @id @default(autoincrement())
  texto      String
  direcao    String   // "entrada" ou "saida"
  createdAt  DateTime @default(now())

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}

model Exame {
  id         Int      @id @default(autoincrement())
  tipo       String
  dataExame  String?  // ISO date
  resultado  String?  // texto ou link
  arquivoUrl String?  // opcional

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}

model Consulta {
  id         Int      @id @default(autoincrement())
  dataHora   String   // ISO datetime
  local      String
  status     String   // "agendada", "realizada", "cancelada"

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}