generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Administrador {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  cargo     String   // "ADMIN_GERAL", "COORDENADOR", "SECRETARIO", "TECNICO"
  municipio String
  senhaHash String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id                     Int       @id @default(autoincrement())
  nome                   String
  telefone               String    @unique
  dataNascimento         String?
  dataUltimaMenstruacao  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  mensagens  Mensagem[]
  exames     Exame[]
  consultas  Consulta[]
}

model Mensagem {
  id         Int      @id @default(autoincrement())
  texto      String   @db.Text
  direcao    String   // "entrada" ou "saida"
  createdAt  DateTime @default(now())

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}

model Exame {
  id         Int      @id @default(autoincrement())
  tipo       String
  dataExame  String?
  resultado  String?  @db.Text
  arquivoUrl String?

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}

model Consulta {
  id         Int      @id @default(autoincrement())
  dataHora   String
  local      String
  status     String   // "agendada", "realizada", "cancelada"

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}
