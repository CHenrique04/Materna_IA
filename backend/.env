# ─────────────────────────────────────────
# Banco de Dados MySQL
# ─────────────────────────────────────────
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:suasenha@localhost:3306/materna_ia"

# ─────────────────────────────────────────
# Gemini API
# ─────────────────────────────────────────
GEMINI_API_KEY="sua_chave_gemini_aqui"

# ─────────────────────────────────────────
# WhatsApp Business API (Meta)
# ─────────────────────────────────────────
# Token permanente gerado no painel Meta for Developers
WA_TOKEN="seu_token_whatsapp_aqui"

# Token de verificação do webhook (você define, pode ser qualquer string)
WA_VERIFY_TOKEN="materna_webhook_secret_2024"

# ─────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────
PORT=3000
